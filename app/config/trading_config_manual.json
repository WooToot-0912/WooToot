{
  "system_name": "景陶易购自动交易系统",
  "version": "2.0.0",
  "initial_capital": 10000,
  "strategy": {
    "adaptive_mode": true,
    "min_confidence_threshold": 0.6,
    "signal_cooldown": 30,
    "strategy_weights": {
      "red_green_strategy": 0.25,
      "macd_strategy": 0.2,
      "price_action_strategy": 0.2,
      "volume_strategy": 0.15,
      "trend_following_strategy": 0.2
    }
  },
  "risk": {
    "max_daily_loss_pct": 0.05,
    "max_single_loss_pct": 0.02,
    "max_position_size_pct": 0.2,
    "max_positions": 5,
    "enable_circuit_breaker": true,
    "circuit_breaker_threshold": -100
  },
  "monitoring": {
    "monitor_interval": 5,
    "notification_channels": [
      "log",
      "file"
    ],
    "alert_file": "logs/system_alerts.json",
    "thresholds": {
      "cpu_usage": 85.0,
      "memory_usage": 90.0,
      "daily_loss": 0.05,
      "error_rate": 0.1
    }
  },
  "ui": {
    "window_title": "景陶易购",
    "detection_timeout": 10,
    "template_threshold": 0.8,
    "max_retries": 3
  },
  "price_detection": {
    "use_manual_price_selection": true,
    "ocr_fallback_enabled": true,
    "price_update_interval": 1.0,
    "price_validation_range": {
      "min_price": 500,
      "max_price": 2000
    }
  }
}